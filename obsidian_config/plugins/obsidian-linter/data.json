{
  "ruleConfigs": {
    "yaml-key-sort": {
      "enabled": true,
      "yaml-key-priority-sort-order": "type\naliases\ndate\ncustomer\nproject\nvendor\ncategory\nowner\nindustry\ntier\nstatus\nproduct-area",
      "priority-keys-at-start-of-yaml": true,
      "yaml-sort-order-for-other-keys": "None"
    },
    "blank-line-after-yaml": {
      "enabled": true
    },
    "heading-blank-lines": {
      "enabled": true
    },
    "consecutive-blank-lines": {
      "enabled": true
    },
    "trailing-spaces": {
      "enabled": true
    },
    "remove-multiple-spaces": {
      "enabled": true
    },
    "remove-empty-lines-between-list-markers-and-checklists": {
      "enabled": true
    },
    "header-increment": {
      "enabled": true
    },
    "consistent-bullet-list-marker-style": {
      "enabled": true,
      "list-marker-style": "consistent"
    },
    "yaml-tags-section-tag-key": {
      "enabled": true
    },
    "yaml-deduplicate-tags": {
      "enabled": true
    },
    "remove-yaml-keys": {
      "enabled": false
    },
    "format-tags-in-yaml": {
      "enabled": true
    }
  },
  "lintOnSave": false,
  "displayChanged": true,
  "foldersToIgnore": [
    "Templates",
    "Prompts",
    "Bases",
    "Assets"
  ],
  "linterLocale": "system-default",
  "logLevel": "ERROR",
  "lintCommands": [],
  "customRegexes": [],
  "commonStyles": {
    "aliasArrayStyle": "multi-line",
    "tagArrayStyle": "multi-line",
    "minimumNumberOfDollarSignsToBeAMathBlock": 2,
    "escapeCharacter": "\""
  }
}
